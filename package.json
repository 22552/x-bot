{
  "name": "x-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit && wrangler deploy --dry-run",
    "register": "node scripts/register.mjs"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "latest",
    "wrangler": "latest"
  },
  "cloudflare": {
    "bindings": {
      "DISCORD_PUBLIC_KEY": {
        "description": "Discord Developer Portal → General Information → Public Key. Required to verify Interaction signatures."
      }
    }
  }
}
